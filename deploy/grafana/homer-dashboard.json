{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["homer"],
      "targetBlank": true,
      "title": "Homer Web UI",
      "tooltip": "Открыть Web UI Homer",
      "type": "link",
      "url": "http://homer.example.com:8080/"
    }
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "homer_queue_jobs_in_progress",
          "refId": "A"
        }
      ],
      "title": "Выполняется сейчас",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(homer_queue_jobs_total{status=\"pending\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Pending (rate 5m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(homer_queue_jobs_total{status=\"failed\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Failed (rate 5m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 30}
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(homer_queue_job_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "title": "p95 duration",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "done"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "failed"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "canceled"}, "properties": [{"id": "color", "value": {"fixedColor": "gray", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "timeout"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 5,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(homer_queue_jobs_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Завершения по статусам (rate 5m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 6,
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(homer_queue_job_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.90, sum(rate(homer_queue_job_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum(rate(homer_queue_job_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "C"},
        {"expr": "histogram_quantile(0.99, sum(rate(homer_queue_job_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "D"}
      ],
      "title": "Длительность задач (перцентили)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 7,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}
      },
      "targets": [
        {
          "expr": "sum by (command) (rate(homer_command_executions_total[5m]))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ],
      "title": "Топ команд по частоте",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "bars", "fillOpacity": 60},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "sum by (status) (increase(homer_command_executions_total[1h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Команды за час по статусам",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [
        {"expr": "sum by (provider, status) (rate(homer_notifications_total[5m]))", "legendFormat": "{{provider}}/{{status}}", "refId": "A"}
      ],
      "title": "Уведомления (rate 5m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 5},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum by (driver, op) (rate(homer_db_queries_total[5m]))", "legendFormat": "{{driver}}/{{op}}", "refId": "A"}
      ],
      "title": "SQL-запросы по драйверам",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}},
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*notify.*"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum by (source) (rate(homer_errors_total[5m]))", "legendFormat": "{{source}}", "refId": "A"}
      ],
      "title": "Ошибки по источникам",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "time() - homer_scheduler_last_tick_timestamp", "legendFormat": "секунд с последнего tick", "refId": "A"}
      ],
      "title": "Возраст последнего tick()",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "sum(rate(homer_scheduler_ticks_total[5m]))", "legendFormat": "tick/s", "refId": "A"}
      ],
      "title": "Частота tick()",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
      "id": 14,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "histogram_quantile(0.90, sum(rate(homer_job_attempts_bucket[1h])) by (le))", "legendFormat": "p90 попыток", "refId": "A"}
      ],
      "title": "Распределение попыток (p90 за 1h)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homer", "queue", "scheduler"],
