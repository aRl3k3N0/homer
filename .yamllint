# Конфигурация yamllint.
extends: default

rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start: disable
  empty-lines:
    max: 2
  indentation:
    spaces: 2
    indent-sequences: whatever

ignore: |
  .venv/
  venv/
  var/
  logs/
  docs/api-generated/_build/
  .github/workflows/
